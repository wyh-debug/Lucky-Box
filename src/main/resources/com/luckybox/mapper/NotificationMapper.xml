<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.luckybox.mapper.NotificationMapper">

    <insert id="saveBatch">
        insert into notification (`user_id`, `title`, `content`, `type`, `creator_id`, `update_id`)
        VALUES
        <foreach collection="dto" item="i" separator=",">
            (#{i.userId}, #{i.title}, #{i.content}, #{i.type}, 0, 0)
        </foreach>
    </insert>
</mapper>